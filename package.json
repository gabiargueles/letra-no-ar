{
  "name": "letra-no-ar",
  "version": "1.0.0",
  "description": "Letra no Ar — janelinha sempre em primeiro plano que mostra a letra sincronizada da música tocando no Spotify",
  "author": "Gabbie",
  "main": "main.js",
  "scripts": {
    "app": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gabbie.letranoar",
    "productName": "Letra no Ar",
    "files": [
      "main.js",
      "preload.js",
      "letras.js",
      "spotify-letras.js",
      "ui/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/kuromoji/dict/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "LetraNoAr-Portatil-${version}.exe",
      "unpackDirName": "LetraNoAr"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Letra no Ar",
      "artifactName": "LetraNoAr-Instalador-${version}.exe"
    }
  },
  "dependencies": {
    "kuroshiro": "^1.2.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0"
  }
}
